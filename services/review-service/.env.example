ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/review_service

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=code_review_events
RABBITMQ_CONSUME_QUEUE=review_service.review_completed
RABBITMQ_CONSUME_ROUTING_KEY=review.completed

JWT_PUBLIC_KEY_PATH=../auth-service/keys/public.pem
JWT_ISSUER=auth-service
JWT_AUDIENCE=code-review-platform

CORS_ALLOW_ORIGINS=["http://localhost:3000"]
