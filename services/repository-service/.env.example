ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/repository_service
REDIS_URL=redis://localhost:6379/1

JWT_PUBLIC_KEY_PATH=../auth-service/keys/public.pem
JWT_ISSUER=auth-service
JWT_AUDIENCE=code-review-platform

GITHUB_APP_ID=replace_me
GITHUB_APP_PRIVATE_KEY_PATH=./keys/github_app_private_key.pem
GITHUB_WEBHOOK_SECRET=replace_me
GITHUB_APP_SLUG=your-app-slug

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=code_review_events

INTERNAL_SERVICE_API_KEY=replace_me_with_a_long_random_value
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
