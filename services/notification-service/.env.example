ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/notification_service

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=code_review_events
RABBITMQ_CONSUME_QUEUE=notification_service.review_completed
RABBITMQ_CONSUME_ROUTING_KEY=review.completed

REPOSITORY_SERVICE_BASE_URL=http://localhost:8001
INTERNAL_SERVICE_API_KEY=replace_me_with_a_long_random_value

JWT_PUBLIC_KEY_PATH=../auth-service/keys/public.pem
JWT_ISSUER=auth-service
JWT_AUDIENCE=code-review-platform

CORS_ALLOW_ORIGINS=["http://localhost:3000"]
