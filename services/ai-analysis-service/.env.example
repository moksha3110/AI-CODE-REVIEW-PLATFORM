ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_analysis_service

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=code_review_events
RABBITMQ_CONSUME_QUEUE=ai_analysis.analysis_requested
RABBITMQ_CONSUME_ROUTING_KEY=analysis.requested

REPOSITORY_SERVICE_BASE_URL=http://localhost:8001
INTERNAL_SERVICE_API_KEY=replace_me_with_a_long_random_value

ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=4096
